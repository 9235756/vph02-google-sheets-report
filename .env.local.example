# Скопируйте этот файл в .env.local и заполните. .env.local в git не попадает.

# Путь к JSON-ключу сервисного аккаунта (относительно корня проекта или абсолютный)
GOOGLE_CREDENTIALS_PATH=service_account.json

# ID таблицы — часть URL между /d/ и /edit
SPREADSHEET_ID=

# Название компании в шапке отчёта (можно поменять и в окне приложения)
REPORT_COMPANY_NAME=ООО «Пример»
